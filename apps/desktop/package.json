{
  "name": "@versionstead/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "start": "install-electron && node scripts/start-electron.mjs .",
    "smoke": "install-electron && node scripts/smoke-test.mjs . --smoke-test"
  },
  "dependencies": {
    "@versionstead/contracts": "workspace:*",
    "@versionstead/server": "workspace:*"
  },
  "devDependencies": {
    "electron": "44.5.1"
  }
}
