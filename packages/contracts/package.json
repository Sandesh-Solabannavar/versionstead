{
  "name": "@versionstead/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./desktop": {
      "types": "./dist/desktop.d.ts",
      "default": "./dist/desktop.js"
    },
    "./global-tool-updates": {
      "types": "./dist/global-tool-updates.d.ts",
      "default": "./dist/global-tool-updates.js"
    },
    "./project-settings": {
      "types": "./dist/project-settings.d.ts",
      "default": "./dist/project-settings.js"
    },
    "./application": {
      "types": "./dist/application.d.ts",
      "default": "./dist/application.js"
    },
    "./monitoring": {
      "types": "./dist/monitoring.d.ts",
      "default": "./dist/monitoring.js"
    },
    "./status": {
      "types": "./dist/status.d.ts",
      "default": "./dist/status.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "effect": "4.0.0"
  }
